generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
  CUSTOMER
  ENTERPRISE_ADMIN
  ENTERPRISE_USER
}

enum CustomerType {
  INDIVIDUAL
  ENTERPRISE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  STOLEN
}

enum VehicleClass {
  MOTORCYCLE
  SEDAN
  SUV
  TRUCK
  BUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RFIDTagStatus {
  ACTIVE
  LOST
  DAMAGED
  DEACTIVATED
}

enum TollPlazaStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TollEventStatus {
  ENTRY
  EXIT
  COMPLETED
  FAILED
}

enum TransactionType {
  DEBIT
  TOPUP
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum ViolationType {
  NO_RFID
  INSUFFICIENT_BALANCE
  RFID_ANPR_MISMATCH
  UNREGISTERED_VEHICLE
}

enum ViolationStatus {
  PENDING
  PROCESSING
  PAID
  ESCALATED
  DISMISSED
  RESOLVED
}

enum DeviceType {
  RFID_READER
  ANPR_CAMERA
  LIDAR
  LANE_CONTROLLER
  BARRIER_GATE
  TICKET_DISPENSER
  LED_SIGN
  INTERCOM
  IP_CAMERA
}

enum DeviceStatusEnum {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  name                  String
  role                  UserRole      @default(VIEWER)
  customerType          CustomerType  @default(INDIVIDUAL) @map("customer_type")
  phone                 String?
  nrcNumber             String?       @map("nrc_number")
  drivingLicense        String?       @map("driving_license")
  companyName           String?       @map("company_name")
  companyRegNo          String?       @map("company_reg_no")
  companyAddress        String?       @map("company_address")
  fleetManagerName      String?       @map("fleet_manager_name")
  smsProvider           String?       @map("sms_provider")
  smsEnabled            Boolean       @default(false) @map("sms_enabled")
  resetToken            String?       @map("reset_token")
  resetTokenExpiry      DateTime?     @map("reset_token_expiry")
  twoFactorSecret       String?       @map("two_factor_secret")
  twoFactorEnabled      Boolean       @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes  String?       @map("two_factor_backup_codes")
  customPermissions     String?       @map("custom_permissions")
  language              String        @default("en")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  accounts      Account[]
  notifications Notification[]
  smsLogs       SMSLog[]

  @@map("users")
}

model Account {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  accountNumber   String?       @unique @map("account_number")
  customerType    CustomerType  @default(INDIVIDUAL) @map("customer_type")
  balance         Decimal       @default(0) @db.Decimal(10, 2)
  creditLimit     Decimal       @default(0) @db.Decimal(10, 2) @map("credit_limit")
  paymentTerms    Int?          @map("payment_terms")
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  rfidTags      RFIDTag[]
  transactions  Transaction[]
  loyaltyPoints LoyaltyPoints[]

  @@map("accounts")
}

model SMSLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String
  phone       String
  message     String
  status      String   @default("sent")
  externalId  String?  @map("external_id")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sms_logs")
}

model Vehicle {
  id              String         @id @default(uuid())
  plateNumber     String         @unique @map("plate_number")
  make            String
  model           String
  year            Int
  color           String?
  vehicleClass    VehicleClass   @map("vehicle_class")
  status          VehicleStatus  @default(ACTIVE)
  approvalStatus  ApprovalStatus @default(APPROVED) @map("approval_status")
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedReason  String?        @map("rejected_reason")
  vehiclePhoto    String?        @map("vehicle_photo")
  wheelTaxCard    String?        @map("wheel_tax_card")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  rfidTags       RFIDTag[]
  tollEvents     TollEvent[]
  violations     Violation[]

  @@map("vehicles")
}

model RFIDTag {
  id         String         @id @default(uuid())
  tagUid     String         @unique @map("tag_uid")
  vehicleId  String         @map("vehicle_id")
  accountId  String         @map("account_id")
  status     RFIDTagStatus  @default(ACTIVE)
  issuedAt   DateTime       @default(now()) @map("issued_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id])
  account    Account        @relation(fields: [accountId], references: [id])
  tollEvents TollEvent[]

  @@map("rfid_tags")
}

model TollPlaza {
  id          String          @id @default(uuid())
  name        String
  gateCode    String?         @unique @map("gate_code")
  locationLat Decimal         @map("location_lat") @db.Decimal(10, 7)
  locationLng Decimal         @map("location_lng") @db.Decimal(10, 7)
  mileMarker  Int?            @map("mile_marker")
  lanes       Int             @default(4)
  status      TollPlazaStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tollRates   TollRate[]
  tollEvents  TollEvent[]
  deviceStatuses DeviceStatus[]

  @@map("toll_plazas")
}

model TollRate {
  id          String   @id @default(uuid())
  plazaId     String   @map("plaza_id")
  vehicleClass VehicleClass @map("vehicle_class")
  rateAmount  Decimal  @map("rate_amount") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt   DateTime @default(now()) @map("created_at")

  plaza       TollPlaza @relation(fields: [plazaId], references: [id])

  @@map("toll_rates")
}

model TollEvent {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  plazaId     String          @map("plaza_id")
  rfidTagId   String?         @map("rfid_tag_id")
  anprPlate   String?         @map("anpr_plate")
  laneNumber  String?         @map("lane_number")
  direction   String?         @default("DOWN")
  entryTime   DateTime        @default(now()) @map("entry_time")
  exitTime    DateTime?       @map("exit_time")
  amount      Decimal?        @db.Decimal(10, 2)
  status      TollEventStatus @default(ENTRY)
  createdAt   DateTime        @default(now()) @map("created_at")

  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
  plaza       TollPlaza       @relation(fields: [plazaId], references: [id])
  rfidTag     RFIDTag?        @relation(fields: [rfidTagId], references: [id])
  transaction Transaction?
  violation   Violation?
  photos      VehiclePhoto[]

  @@map("toll_events")
}

model Transaction {
  id            String            @id @default(uuid())
  accountId     String            @map("account_id")
  eventId       String?           @unique @map("event_id")
  amount        Decimal           @db.Decimal(10, 2)
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  paymentMethod String?           @map("payment_method")
  description   String?
  createdAt     DateTime          @default(now()) @map("created_at")

  account       Account           @relation(fields: [accountId], references: [id])
  event         TollEvent?        @relation(fields: [eventId], references: [id])

  @@map("transactions")
}

model Violation {
  id            String          @id @default(uuid())
  vehicleId     String          @map("vehicle_id")
  eventId       String          @unique @map("event_id")
  violationType ViolationType   @map("violation_type")
  status        ViolationStatus @default(PENDING)
  fineAmount    Decimal         @map("fine_amount") @db.Decimal(10, 2)
  dueDate       DateTime        @map("due_date")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])
  event         TollEvent       @relation(fields: [eventId], references: [id])

  @@map("violations")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String?
  message   String
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model DeviceStatus {
  id            String     @id @default(uuid())
  plazaId       String     @map("plaza_id")
  deviceType    DeviceType @map("device_type")
  deviceId      String     @map("device_id")
  name          String?
  ipAddress     String?    @map("ip_address")
  port          Int?
  apiUrl        String?    @map("api_url")
  apiKey        String?    @map("api_key")
  lane          Int?       @default(1)
  model         String?
  manufacturer  String?
  firmware      String?
  status        DeviceStatusEnum @default(ONLINE)
  lastHeartbeat DateTime?  @map("last_heartbeat")
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  plaza         TollPlaza  @relation(fields: [plazaId], references: [id])

  @@map("device_status")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  type        String   // PERCENTAGE, FIXED, FREE_TRIPS
  value       Decimal  @db.Decimal(10, 2)
  maxUses     Int      @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  validFrom   DateTime @map("valid_from")
  validTo     DateTime @map("valid_to")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("promo_codes")
}

model LoyaltyPoints {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  points    Int      @default(0)
  earned    Int      @default(0)
  redeemed  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account   Account  @relation(fields: [accountId], references: [id])

  @@map("loyalty_points")
}

model Webhook {
  id         String   @id @default(uuid())
  url        String
  events     String   // JSON array of event names
  secret     String
  active     Boolean  @default(true)
  retryCount Int      @default(3) @map("retry_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

model VehiclePhoto {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  photoType String   @map("photo_type") // ENTRY, EXIT
  photoUrl  String   @map("photo_url")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  event     TollEvent @relation(fields: [eventId], references: [id])

  @@map("vehicle_photos")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  settings  Json?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}
