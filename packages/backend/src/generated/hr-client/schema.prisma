generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/hr-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// HR MODULE — Separate Database
// ═══════════════════════════════════════════════════════

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum DepartmentType {
  OPERATIONS
  FINANCE
  ENGINEERING
  HR
  MAINTENANCE
  SECURITY
  ADMIN
  CUSTOMER_SERVICE
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum PerformanceRating {
  EXCELLENT
  GOOD
  AVERAGE
  BELOW_AVERAGE
  POOR
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

// ═══════════════════════════════════════════════════════
// HR User (shared login with TollGate)
// ═══════════════════════════════════════════════════════

model HrUser {
  id             String    @id @default(uuid())
  tollgateUserId String    @unique @map("tollgate_user_id")
  email          String    @unique
  name           String
  role           String    @default("HR_USER")
  status         String    @default("ACTIVE")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tollgateUserId])
  @@index([email])
  @@map("hr_users")
}

// ═══════════════════════════════════════════════════════
// DEPARTMENTS & POSITIONS
// ═══════════════════════════════════════════════════════

model Department {
  id          String         @id @default(uuid())
  name        String         @unique
  code        String         @unique
  type        DepartmentType
  description String?
  managerId   String?        @map("manager_id")
  parentId    String?        @map("parent_id")
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  employees Employee[]
  positions Position[]
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")

  @@index([type])
  @@index([status])
  @@map("departments")
}

model Position {
  id           String   @id @default(uuid())
  title        String
  code         String   @unique
  departmentId String   @map("department_id")
  level        Int      @default(1)
  minSalary    Decimal? @map("min_salary") @db.Decimal(12, 2)
  maxSalary    Decimal? @map("max_salary") @db.Decimal(12, 2)
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employees  Employee[]
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([status])
  @@map("positions")
}

// ═══════════════════════════════════════════════════════
// EMPLOYEES
// ═══════════════════════════════════════════════════════

model Employee {
  id               String         @id @default(uuid())
  employeeNumber   String         @unique @map("employee_number")
  tollgateUserId   String?        @unique @map("tollgate_user_id")
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  email            String         @unique
  phone            String?
  nrcNumber        String?        @map("nrc_number")
  dateOfBirth      DateTime?      @map("date_of_birth")
  gender           String?
  address          String?
  emergencyContact String?        @map("emergency_contact")
  emergencyPhone   String?        @map("emergency_phone")
  departmentId     String         @map("department_id")
  positionId       String         @map("position_id")
  managerId        String?        @map("manager_id")
  hireDate         DateTime       @map("hire_date")
  salary           Decimal        @db.Decimal(12, 2)
  status           EmployeeStatus @default(ACTIVE)
  terminationDate  DateTime?      @map("termination_date")
  profilePhoto     String?        @map("profile_photo")
  notes            String?
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  department          Department           @relation(fields: [departmentId], references: [id])
  position            Position             @relation(fields: [positionId], references: [id])
  manager             Employee?            @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports       Employee[]           @relation("EmployeeHierarchy")
  attendances         Attendance[]
  shiftAssignments    ShiftAssignment[]
  leaveRequests       LeaveRequest[]
  payrolls            Payroll[]
  performances        PerformanceReview[]
  trainingEnrollments TrainingEnrollment[]

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([status])
  @@index([hireDate])
  @@index([employeeNumber])
  @@map("employees")
}

// ═══════════════════════════════════════════════════════
// ATTENDANCE & SHIFTS
// ═══════════════════════════════════════════════════════

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String           @map("employee_id")
  date        DateTime         @map("date")
  clockIn     DateTime?        @map("clock_in")
  clockOut    DateTime?        @map("clock_out")
  status      AttendanceStatus @default(PRESENT)
  hoursWorked Decimal?         @map("hours_worked") @db.Decimal(4, 2)
  overtime    Decimal?         @default(0) @db.Decimal(4, 2)
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model Shift {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  breakMins Int      @default(60) @map("break_mins")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments ShiftAssignment[]

  @@map("shifts")
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  shiftId    String   @map("shift_id")
  date       DateTime @map("date")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([shiftId])
  @@index([date])
  @@map("shift_assignments")
}

// ═══════════════════════════════════════════════════════
// LEAVE
// ═══════════════════════════════════════════════════════

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String      @map("employee_id")
  leaveType       LeaveType   @map("leave_type")
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  days            Int
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedBy      String?     @map("approved_by")
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
  @@map("leave_requests")
}

// ═══════════════════════════════════════════════════════
// PAYROLL
// ═══════════════════════════════════════════════════════

model Payroll {
  id          String        @id @default(uuid())
  employeeId  String        @map("employee_id")
  payPeriod   String        @map("pay_period")
  baseSalary  Decimal       @map("base_salary") @db.Decimal(12, 2)
  allowances  Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay Decimal       @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  bonus       Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  netPay      Decimal       @map("net_pay") @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?     @map("paid_at")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, payPeriod])
  @@index([employeeId])
  @@index([payPeriod])
  @@index([status])
  @@map("payroll")
}

// ═══════════════════════════════════════════════════════
// PERFORMANCE
// ═══════════════════════════════════════════════════════

model PerformanceReview {
  id           String            @id @default(uuid())
  employeeId   String            @map("employee_id")
  reviewerId   String            @map("reviewer_id")
  period       String
  rating       PerformanceRating
  goals        Json?
  strengths    String?
  improvements String?
  comments     String?
  nextReview   DateTime?         @map("next_review")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([rating])
  @@index([period])
  @@map("performance_reviews")
}

// ═══════════════════════════════════════════════════════
// TRAINING
// ═══════════════════════════════════════════════════════

model Training {
  id          String         @id @default(uuid())
  title       String
  code        String         @unique
  description String?
  duration    Int?
  provider    String?
  cost        Decimal?       @db.Decimal(10, 2)
  maxEnroll   Int?           @map("max_enrollment")
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  status      TrainingStatus @default(PLANNED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  enrollments TrainingEnrollment[]

  @@index([status])
  @@map("trainings")
}

model TrainingEnrollment {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  trainingId  String    @map("training_id")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")
  score       Int?
  certificate String?
  status      String    @default("ENROLLED")

  employee Employee @relation(fields: [employeeId], references: [id])
  training Training @relation(fields: [trainingId], references: [id])

  @@unique([employeeId, trainingId])
  @@index([employeeId])
  @@index([trainingId])
  @@index([status])
  @@map("training_enrollments")
}
