generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("PLAZA_DATABASE_URL")
}

model PlazaConfig {
  id         String   @id @default(uuid())
  plazaCode  String   @unique @map("plaza_code")
  plazaName  String   @map("plaza_name")
  location   String?
  lanes      Int      @default(4)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("plaza_config")
}

model SyncQueue {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  payload    String
  status     String   @default("PENDING")
  retries    Int      @default(0)
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at")
  syncedAt   DateTime? @map("synced_at")

  @@map("sync_queue")
  @@index([status])
  @@index([entityType])
  @@index([createdAt])
}

model SyncStatus {
  id             String    @id @default(uuid())
  entityType     String    @map("entity_type")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastSyncId     String?   @map("last_sync_id")
  recordsSynced  Int       @default(0) @map("records_synced")
  status         String    @default("IDLE")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("sync_status")
}

model LocalTollEvent {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  plazaId     String   @map("plaza_id")
  rfidTagId   String?  @map("rfid_tag_id")
  anprPlate   String?  @map("anpr_plate")
  laneNumber  String?  @map("lane_number")
  direction   String?  @default("DOWN")
  entryTime   DateTime @default(now()) @map("entry_time")
  exitTime    DateTime? @map("exit_time")
  amount      Float?
  status      String   @default("ENTRY")
  synced      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("local_toll_events")
  @@index([vehicleId])
  @@index([plazaId])
  @@index([entryTime])
  @@index([status])
  @@index([synced])
}

model DeviceConfig {
  id            String    @id @default(uuid())
  plazaId       String    @map("plaza_id")
  deviceType    String    @map("device_type")
  deviceId      String    @map("device_id")
  name          String?
  ipAddress     String?   @map("ip_address")
  port          Int?
  apiUrl        String?   @map("api_url")
  apiKey        String?   @map("api_key")
  lane          Int       @default(1)
  model         String?
  manufacturer  String?
  firmware      String?
  status        String    @default("ONLINE")
  lastHeartbeat DateTime? @map("last_heartbeat")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("device_config")
  @@index([plazaId])
  @@index([deviceId])
}
