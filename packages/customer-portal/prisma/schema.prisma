generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CUSTOMER_DATABASE_URL")
}

enum CustomerType {
  INDIVIDUAL
  ENTERPRISE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum RFIDTagStatus {
  ACTIVE
  LOST
  DAMAGED
  DEACTIVATED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
  CUSTOMER
  ENTERPRISE_ADMIN
  ENTERPRISE_USER
}

model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  passwordHash          String       @map("password_hash")
  name                  String
  role                  UserRole     @default(CUSTOMER)
  customerType          CustomerType @default(INDIVIDUAL) @map("customer_type")
  phone                 String?
  nrcNumber             String?      @map("nrc_number")
  drivingLicense        String?      @map("driving_license")
  companyName           String?      @map("company_name")
  companyRegNo          String?      @map("company_reg_no")
  companyAddress        String?      @map("company_address")
  fleetManagerName      String?      @map("fleet_manager_name")
  smsProvider           String?      @map("sms_provider")
  smsEnabled            Boolean      @default(false) @map("sms_enabled")
  resetToken            String?      @map("reset_token")
  resetTokenExpiry      DateTime?    @map("reset_token_expiry")
  twoFactorSecret       String?      @map("two_factor_secret")
  twoFactorEnabled      Boolean      @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes  String?      @map("two_factor_backup_codes")
  customPermissions     String?      @map("custom_permissions")
  language              String       @default("en")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  accounts      Account[]
  notifications Notification[]
  smsLogs       SMSLog[]

  @@map("users")
}

model Account {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  accountNumber   String?       @unique @map("account_number")
  customerType    CustomerType  @default(INDIVIDUAL) @map("customer_type")
  balance         Decimal       @default(0) @db.Decimal(10, 2)
  creditLimit     Decimal       @default(0) @db.Decimal(10, 2) @map("credit_limit")
  paymentTerms    Int?          @map("payment_terms")
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  rfidTags      RFIDTag[]
  loyaltyPoints LoyaltyPoints[]

  @@map("accounts")
  @@index([userId])
  @@index([status])
  @@index([customerType])
}

model RFIDTag {
  id         String         @id @default(uuid())
  tagUid     String         @unique @map("tag_uid")
  accountId  String         @map("account_id")
  vehicleId  String         @map("vehicle_id")
  status     RFIDTagStatus  @default(ACTIVE)
  issuedAt   DateTime       @default(now()) @map("issued_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  account    Account        @relation(fields: [accountId], references: [id])

  @@map("rfid_tags")
  @@index([accountId])
  @@index([vehicleId])
  @@index([tagUid])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String?
  message   String
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId])
  @@index([read])
}

model SMSLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String
  phone       String
  message     String
  status      String   @default("sent")
  externalId  String?  @map("external_id")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sms_logs")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  type        String
  value       Decimal  @db.Decimal(10, 2)
  maxUses     Int      @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  validFrom   DateTime @map("valid_from")
  validTo     DateTime @map("valid_to")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("promo_codes")
}

model LoyaltyPoints {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  points    Int      @default(0)
  earned    Int      @default(0)
  redeemed  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account   Account  @relation(fields: [accountId], references: [id])

  @@map("loyalty_points")
}

model Webhook {
  id         String   @id @default(uuid())
  url        String
  events     String
  secret     String
  active     Boolean  @default(true)
  retryCount Int      @default(3) @map("retry_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String   @unique
  settings  Json?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}
