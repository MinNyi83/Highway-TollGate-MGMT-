{
  "name": "tollgate-rfid-pass",
  "version": "1.0.0",
  "private": true,
  "description": "Highway Tollgate Management System with RFID and ANPR",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "prisma": true,
    "@prisma/client@5.22.0": true,
    "esbuild@0.21.5": true,
    "@prisma/engines@5.22.0": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
